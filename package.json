{
  "name": "bmh-world-simulation-v0",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "BMH World Simulation v0 — an open-source, browser-only living simulation of Hà Nội's Old Quarter. OpenStreetMap streets, three.js, LLM-driven residents, injectable events. BYOK.",
  "scripts": {
    "dev": "vite --port 3418",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 3418",
    "bake": "node scripts/bake-osm.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "fetch-osm": "node scripts/fetch-osm.mjs",
    "shoot": "node scripts/shoot.mjs",
    "test:live": "SIM_LIVE=1 vitest run tests/live.smoke.test.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BMH-AI-Technologies/bmh-world-simulation-v0.git"
  },
  "homepage": "https://github.com/BMH-AI-Technologies/bmh-world-simulation-v0#readme",
  "author": "Hung Bui",
  "keywords": [
    "simulation",
    "llm-agents",
    "openstreetmap",
    "threejs",
    "hanoi",
    "generative-agents"
  ]
}
